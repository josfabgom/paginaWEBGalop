server {
    listen 80;
    server_name galopsrl.com.ar www.galopsrl.com.ar dashboard.galopsrl.com.ar;

    root /var/www/galopsrl;
    index landing.html index.html;

    # Archivos estáticos en assets
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    # Rutas API procesadas por el servidor backend de GaLop
    location /api/ {
        proxy_pass http://localhost:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Portal Personal / Admin ABM
    location = /portal {
        try_files /admin.html =404;
    }
    location = /admin {
        try_files /admin.html =404;
    }

    # Catálogo de Productos
    location = /productos {
        try_files /index.html =404;
    }
    location = /catalogo {
        try_files /index.html =404;
    }

    # Demostración Cartelería Digital
    location = /demo-carteleria {
        try_files /demo-carteleria.html =404;
    }
    location = /carteleria {
        try_files /demo-carteleria.html =404;
    }

    # Página Principal (Landing)
    location = / {
        try_files /landing.html =404;
    }
    location = /landing {
        try_files /landing.html =404;
    }
    location = /inicio {
        try_files /landing.html =404;
    }

    # Delegación a Next.js (/login, /dashboard) o archivos estáticos
    location / {
        try_files $uri $uri/ @nextjs;
    }

    location @nextjs {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
